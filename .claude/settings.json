{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Write(./reports/**)",
      "Write(./CLAUDE.md)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(./tools/odeslat-zpravu.sh:*)",
      "Bash(date:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/notify.sh \"Agent dokončil práci\""
          }
        ]
      }
    ]
  }
}
